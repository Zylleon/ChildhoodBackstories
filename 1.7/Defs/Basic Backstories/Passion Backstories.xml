			<li>ZCB</li>
			<li>ZCB_NaturalMeditation</li>
		</spawnCategories>
		<commonality>0.5</commonality>

		<requiredPassions>
			<li>Animals</li>
		</requiredPassions>

		<skillGains>
			<Animals>5</Animals>
		</skillGains>
	</ZCB.ZCBackstoryDef>



