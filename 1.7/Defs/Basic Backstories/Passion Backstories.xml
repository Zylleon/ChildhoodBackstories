<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ============ ANIMALS ============ -->

	<!-- animal advocate -->
	<ZCB.ZCBackstoryDef>
		<defName>ZCB_AnimalAdvocate</defName>
		<title>animal advocate</title>
		<titleShort>advocate</titleShort>
		<baseDesc>[PAWN_nameDef] loved spending time with pets and livestock. [PAWN_pronoun] advocated for the colony to treat them well, and could never bring [PAWN_objective]self to hurt a living creature.</baseDesc>
		<slot>Childhood</slot>
		<spawnCategories>
			<li>ZCB</li>
			<li>ZCB_NaturalMeditation</li>
		</spawnCategories>
		<commonality>0.5</commonality>

		<requiredPassions>
			<li>Animals</li>
		</requiredPassions>
		<disallowedPassions>
			<li>Social</li>
		</disallowedPassions>

		<passionGains>
			<li>
				<key>Animals</key>
				<value>1</value>
			</li>
		</passionGains>
		<workDisables>
			<li>Violent</li>
		</workDisables>
		<skillGains>
			<Animals>5</Animals>
			<Medicine>1</Medicine>
			<Social>-2</Social>
		</skillGains>
	</ZCB.ZCBackstoryDef>


	<!-- aspiring vetinarian -->
	<ZCB.ZCBackstoryDef>
		<defName>ZCB_AspiringVetinarian</defName>
		<title>aspiring vetinarian</title>
		<titleShort>vet</titleShort>
		<baseDesc>[PAWN_nameDef] wanted nothing more than to be a vet, helping animals in need. While playing pretend, [PAWN_pronoun] would repair stuffed animals as if they were [PAWN_possessive] patients.</baseDesc>
		<slot>Childhood</slot>
		<spawnCategories>
			<li>ZCB</li>
		</spawnCategories>
		<commonality>1.5</commonality>

		<requiredPassions>
			<li>Animals</li>
			<li>Medicine</li>
		</requiredPassions>

		<skillGains>
			<Crafting>5</Crafting>
			<Medicine>1</Medicine>
		</skillGains>
	</ZCB.ZCBackstoryDef>



	<!-- zoolater -->
	<ZCB.ZCBackstoryDef>
		<defName>ZCB_Zoolater</defName>
		<title>zoolater</title>
		<titleShort>zoolater</titleShort>
		<baseDesc>[PAWN_nameDef] loved animals more than anything else. [PAWN_pronoun] spent as much time around them as possible, learning every habit and preference.</baseDesc>
		<slot>Childhood</slot>
