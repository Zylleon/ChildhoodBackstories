		<defName>ZCB_Misanthrope</defName>
		<title>misanthrope</title>
		<titleShort>misanthrope</titleShort>
		<baseDesc>[PAWN_nameDef] spent much of [PAWN_possessive] with [PAWN_possessive] nose in a book. In doing so, [PAWN_pronoun] learned to be cynical about human nature.</baseDesc>
		<slot>Childhood</slot>
		<spawnCategories>
			<li>ZCB</li>
		</spawnCategories>
		<commonality>1.5</commonality>
		<!-- new tags start here -->
		<requiredRecords>
			<li>
				<name>ZCB_TimeReading</name>
				<minValue>450000</minValue><!-- 7.5 days -->
			</li>
		</requiredRecords>
		<disallowedPassions>
			<li>Social</li>
		</disallowedPassions>
		<!-- new tags end here-->

		<skillGains>
			<Intellectual>+2</Intellectual>
			<Shooting>-1</Shooting>
