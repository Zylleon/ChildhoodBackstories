<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- bookworm -->
	<ZCB.ZCBackstoryDef>
		<defName>ZCB_Bookworm2</defName>
		<title>bookworm</title>
		<titleShort>bookworm</titleShort>
		<baseDesc>[PAWN_nameDef] spent much of [PAWN_possessive] with [PAWN_possessive] nose in a book, to the detriment of [PAWN_possessive] physical development.</baseDesc>
		<slot>Childhood</slot>
		<spawnCategories>
			<li>ZCB</li>
		</spawnCategories>
		<commonality>1.5</commonality>
		<!-- new tags start here -->
		<requiredRecords>
			<li>
				<name>ZCB_TimeReading</name>
				<minValue>500000</minValue><!-- 8.3 days -->
			</li>
		</requiredRecords>
		<!-- new tags end here-->

		<skillGains>
			<Intellectual>+2</Intellectual>
			<Social>+1</Social>
			<Melee>-3</Melee>
			<Construction>-1</Construction>
		</skillGains>
	</ZCB.ZCBackstoryDef>


	<!-- bookworm - misanthrope -->
