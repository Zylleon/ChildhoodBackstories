		<spawnCategories>
			<li>ZCB</li>
			<li>ZCB_NaturalMeditation</li>
		</spawnCategories>
		<commonality>0.75</commonality>
		<!-- new tags start here -->
		<requiredRecords>
			<li>
				<name>ZCB_TimeReading</name>
				<minValue>450000</minValue><!-- 7.5 days -->
			</li>
			<li>
				<name>ZCB_Lessontaking</name>
				<minValue>550000</minValue><!-- 9.2 days -->
